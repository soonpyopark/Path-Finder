# Kakao Maps JavaScript 키 (카카오 개발자 콘솔 > 앱 > 플랫폼 > Web 도메인 등록)
# 브라우저에서 쓰이므로 NEXT_PUBLIC_ 접두사가 필요합니다.
# 로컬: http://localhost:3000
# Vercel: https://<your-project>.vercel.app
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 나이스 교육정보 개방 포털 API 키 (https://open.neis.go.kr)
# 서버 API에서만 사용하므로 NEXT_PUBLIC_을 붙이지 않습니다.
NEIS_API_KEY=
